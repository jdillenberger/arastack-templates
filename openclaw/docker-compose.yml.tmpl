services:
  openclaw-init:
    image: openclaw-arastack:local
    build:
      context: .
      dockerfile: Dockerfile
    container_name: openclaw-init
    restart: "no"
    user: "root"
    entrypoint: ["sh", "-c"]
    environment:
      - ARASTACK_ALLOWED_ORIGINS={{index . "routing_urls"}}
    command:
      - |
        set -e
        chown -R 1000:1000 /home/node/.openclaw
        # Merge our gateway overrides into openclaw.json without clobbering
        # runtime additions (default model, agent profiles, meta, …). Idempotent.
        python3 - <<'PY'
        import json, os
        path = "/home/node/.openclaw/openclaw.json"
        cfg = {}
        if os.path.exists(path):
            try:
                with open(path) as f:
                    cfg = json.load(f)
            except Exception:
                cfg = {}
        origins = [u for u in os.environ.get("ARASTACK_ALLOWED_ORIGINS", "").split(",") if u]
        cfg.setdefault("gateway", {})
        cfg["gateway"]["controlUi"] = {"allowedOrigins": origins}
        cfg["gateway"]["trustedProxies"] = ["172.16.0.0/12", "10.0.0.0/8", "192.168.0.0/16"]
        with open(path, "w") as f:
            json.dump(cfg, f, indent=2)
        PY
        chown 1000:1000 /home/node/.openclaw/openclaw.json
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          memory: 128M
          pids: 50
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    volumes:
      - {{index . "data_dir"}}/config:/home/node/.openclaw
      - {{index . "data_dir"}}/workspace:/home/node/.openclaw/workspace

  openclaw-gateway:
    image: openclaw-arastack:local
    container_name: openclaw-gateway
    restart: unless-stopped
    init: true
    command: ["node", "openclaw.mjs", "gateway", "--allow-unconfigured", "--bind", "lan"]
    depends_on:
      openclaw-init:
        condition: service_completed_successfully
    ports:
      - "{{index . "gateway_port"}}:18789"
      - "{{index . "bridge_port"}}:18790"
    environment:
      - HOME=/home/node
      - TERM=xterm-256color
      - TZ={{index . "timezone"}}
      - OPENCLAW_GATEWAY_TOKEN={{index . "gateway_token"}}
      - CALDAV_URL={{index . "caldav_url"}}
      - CALDAV_USER={{index . "caldav_user"}}
      - CALDAV_PASSWORD={{index . "caldav_password"}}
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://127.0.0.1:18789/healthz || exit 1"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s
    deploy:
      resources:
        limits:
          memory: 2G
          pids: 200
    volumes:
      - {{index . "data_dir"}}/config:/home/node/.openclaw
      - {{index . "data_dir"}}/workspace:/home/node/.openclaw/workspace
    labels:
      - "arabackup.enable=true"
      - "arabackup.borg.paths=config,workspace"
    security_opt:
      - no-new-privileges:true
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
    networks:
      - {{index . "network"}}

  openclaw-cli:
    image: openclaw-arastack:local
    container_name: openclaw-cli
    restart: unless-stopped
    network_mode: "service:openclaw-gateway"
    stdin_open: true
    tty: true
    cap_drop:
      - NET_RAW
      - NET_ADMIN
    deploy:
      resources:
        limits:
          memory: 1G
          pids: 200
    security_opt:
      - no-new-privileges:true
    environment:
      - HOME=/home/node
      - TERM=xterm-256color
      - TZ={{index . "timezone"}}
      - OPENCLAW_GATEWAY_TOKEN={{index . "gateway_token"}}
      - BROWSER=echo
      - CALDAV_URL={{index . "caldav_url"}}
      - CALDAV_USER={{index . "caldav_user"}}
      - CALDAV_PASSWORD={{index . "caldav_password"}}
    volumes:
      - {{index . "data_dir"}}/config:/home/node/.openclaw
      - {{index . "data_dir"}}/workspace:/home/node/.openclaw/workspace
    depends_on:
      openclaw-gateway:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

networks:
  {{index . "network"}}:
    external: true
